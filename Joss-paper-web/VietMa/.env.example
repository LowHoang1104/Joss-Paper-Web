# Example .env — create .env (do NOT commit) and set your real URL
VITE_GOOGLE_SHEET_URL="https://script.google.com/macros/s/XXXXXXXX/exec?key=yourSecretHere"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"

# Supabase Edge Function secrets, set with:
# supabase secrets set PAYOS_CLIENT_ID=... PAYOS_API_KEY=... PAYOS_CHECKSUM_KEY=... GOOGLE_SHEET_URL=...
PAYOS_CLIENT_ID="your-payos-client-id"
PAYOS_API_KEY="your-payos-api-key"
PAYOS_CHECKSUM_KEY="your-payos-checksum-key"
GOOGLE_SHEET_URL="https://script.google.com/macros/s/XXXXXXXX/exec?key=yourSecretHere"
